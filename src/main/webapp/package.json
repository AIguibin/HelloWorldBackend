{
  "name": "aiguibin-platform-arch",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "架构管理平台前端（Vue 3 + Vite + TypeScript）",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.20.0",
    "element-plus": "~2.14.5",
    "pinia": "^3.0.0",
    "vue": "~3.5.42",
    "vue-router": "~4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
