<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiguibin.platform.arch.mapper.MenuMapper">

    <resultMap id="MenuResultMap" type="com.aiguibin.platform.arch.entity.Menu">
        <id column="id" property="id"/>
        <result column="menu_code" property="menuCode"/>
        <result column="menu_name" property="menuName"/>
        <result column="menu_type" property="menuType"/>
        <result column="parent_menu_code" property="parentMenuCode"/>
        <result column="icon" property="icon"/>
        <result column="path" property="path"/>
        <result column="component" property="component"/>
        <result column="url" property="url"/>
        <result column="http_method" property="httpMethod"/>
        <result column="is_external" property="isExternal"/>
        <result column="is_cache" property="isCache"/>
        <result column="is_visible" property="isVisible"/>
        <result column="permission_key" property="permissionKey"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="status" property="status"/>
        <result column="description" property="description"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_time" property="createdTime"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="updated_time" property="updatedTime"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <!-- 根据用户ID查询菜单列表 -->
    <select id="selectMenusByUserId" resultMap="MenuResultMap">
        SELECT DISTINCT m.*
        FROM sys_menu m
        WHERE m.status = 1
          AND m.is_visible = 1
          AND m.is_deleted = 0
        ORDER BY m.sort_order ASC, m.id ASC
    </select>

    <!-- 根据角色ID查询菜单列表 -->
    <select id="selectMenusByRoleId" resultMap="MenuResultMap">
        SELECT m.*
        FROM sys_menu m
        WHERE m.status = 1
          AND m.is_deleted = 0
        ORDER BY m.sort_order ASC, m.id ASC
    </select>

</mapper>

